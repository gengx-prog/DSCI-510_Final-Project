# Copy this file to `.env` in the project root and fill in your keys.

# ACLED credentials — choose ONE method:
#
# Method 1 (recommended): OAuth — register at https://acleddata.com/user/register
#   then set your login email and password below.
ACLED_EMAIL=your_acled_account_email@usc.edu
ACLED_PASSWORD=your_acled_password
#
# Method 2 (legacy): API key — set only if you have an old-style ACLED API key.
# ACLED_API_KEY=your_acled_api_key

# EIA Open Data API key — register free at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key
